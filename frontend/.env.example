# Frontend environment variables for LegalLens
#
# Copy this file to .env.local for local development overrides.
# In production (Vercel), set these in the Vercel dashboard under
# Project Settings → Environment Variables.

# Base URL of the backend API.
# - Local dev: leave empty — Vite proxy forwards /api → http://127.0.0.1:8000
# - Vercel production: set to your Render backend URL (no trailing slash)
VITE_API_BASE_URL=https://legallens-api.onrender.com/api
